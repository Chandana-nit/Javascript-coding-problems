function countEvenNumbers(arr) {
    let count = 0;

    for (const number of arr) {
        if (number % 2 === 0) {
            count++;
        }
    }

    return count;
}

console.log(countEvenNumbers([1, 2, 3, 4, 6])); // Expected: 3
console.log(countEvenNumbers([1, 3, 5]));       // Expected: 0
console.log(countEvenNumbers([2, 8]));          // Expected: 2
